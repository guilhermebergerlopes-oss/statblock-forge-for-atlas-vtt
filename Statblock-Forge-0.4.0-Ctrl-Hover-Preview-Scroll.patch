diff --git a/styles.css b/styles.css
index 20fd45e..2c05767 100644
--- a/styles.css
+++ b/styles.css
@@ -7796,3 +7796,42 @@ body.statblock-forge__entry-dragging * { cursor: grabbing !important; user-selec
   .statblock-forge__json-header { gap: 0.35rem; }
   .statblock-forge__json-header > .statblock-forge__panel-title { font-size: var(--font-ui-small); }
 }
+
+/* Atlas Ctrl-hover provider previews: keep the provider mount and Forge card
+   inside Atlas' max-height flex window. The card's body is the scrollport
+   consumed by Atlas' capture-phase Ctrl+wheel handler. Without this flex chain
+   the body grows to the statblock's full content height and has nothing to
+   scroll, even though Atlas intercepts the wheel event. */
+.atlas-statblock-preview-window .atlas-sheet-render-container.statblock-forge__atlas-preview-mount {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  align-self: stretch;
+  width: 100%;
+  min-width: 0;
+  min-height: 0;
+  max-width: 100%;
+  max-height: 100%;
+  overflow: hidden;
+}
+.atlas-statblock-preview-window .statblock-forge__atlas-preview-mount > .statblock-forge__final-card.atlas-statblock {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  max-width: 100%;
+  max-height: 100%;
+  overflow: hidden;
+}
+.atlas-statblock-preview-window .statblock-forge__atlas-preview-mount > .statblock-forge__final-card.atlas-statblock > .statblock-forge__preview-body {
+  display: flow-root;
+  flex: 1 1 auto;
+  min-width: 0;
+  min-height: 0;
+  max-height: 100%;
+  overflow-x: auto;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  scrollbar-width: thin;
+}
